# Neon manages DATABASE_URL, DATABASE_URL_UNPOOLED, and NEON_BRANCH.
# `neon link` writes them into .env automatically, so you normally do not set
# them by hand. Keep this file as the reference for the rest.
#
# Equivalent manual value (pooled connection, the one the app should use):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Absolute or relative path where rendered photo strips are written when no
# Blob store is configured. Served back through /api/files/[...path].
# On Vercel this folder is ephemeral; connect a Vercel Blob store instead.
STORAGE_DIR="./storage"

# Vercel Blob read/write token for durable photo storage. Required on Vercel;
# optional locally (local disk is used when this is empty). Vercel injects this
# automatically when a Blob store is connected to the project, so you normally
# do not set it by hand in production.
BLOB_READ_WRITE_TOKEN=""

# Public base URL used when building QR codes and share links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Cloudinary credentials, used ONLY on the server to upload strips that a guest
# explicitly chose to publish. The secret lives in the URL, so never prefix this
# with NEXT_PUBLIC_ and never commit a filled-in copy of this file.
# Copy the "Cloudinary URL" value from the Cloudinary console.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Assets are uploaded into this folder inside the cloud.
CLOUDINARY_FOLDER="photo"
# Admin-managed frame overlays get their own folder.
CLOUDINARY_FRAME_FOLDER="snapvibe/frames"

# Seed credentials for the first admin account (used by `npm run db:seed`).
ADMIN_EMAIL="admin@snapvibe.local"
ADMIN_PASSWORD="snapvibe-dev-admin"
# Optional stable access code for the seeded Launch Party event. When empty,
# re-seeding keeps the existing code instead of rotating it.
DEMO_EVENT_CODE=""

# HMAC key for the signed admin session cookie. Generate a long random value,
# for example: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Bearer token for POST/GET /api/cron/cleanup. Production refuses to run the
# cleanup when this is unset. Schedulers must send:
#   Authorization: Bearer <CRON_SECRET>
# Generate it the same way as SESSION_SECRET.
CRON_SECRET=""
